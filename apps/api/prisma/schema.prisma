generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model UserProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keycloakUserId String    @unique
  name           String
  email          String    @unique
  roleSnapshot   UserRole  @default(USER)
  isActiveLocal  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  tasks          Task[]
  // [CATEGORIA] Relação inversa: um usuário pode ter várias categorias próprias.
  taskCategories TaskCategory[]

  @@map("user_profiles")
}

model Session {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash       String      @unique
  userProfileId   String      @db.Uuid
  keycloakSubject String
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  lastUsedAt      DateTime    @default(now())
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      TaskStatus    @default(PENDING)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?
  // [CATEGORIA] Chave estrangeira OPCIONAL: a tarefa pode não ter categoria.
  categoryId  String?       @db.Uuid
  ownerId     String        @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       UserProfile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // [CATEGORIA] Se a categoria for apagada fisicamente do banco, a tarefa fica sem categoria (SetNull).
  category    TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([deletedAt])
  @@index([status])
  // [CATEGORIA] Índice para acelerar o filtro "tarefas da categoria X".
  @@index([categoryId])
  @@map("tasks")
}

// [CATEGORIA] Nova entidade seguindo exatamente o mesmo padrão de Task:
// UUID, ownership (ownerId), soft delete (deletedAt) e timestamps.
model TaskCategory {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  // Cor em hexadecimal (#RRGGBB) usada para pintar o badge na tela de tarefas.
  color     String      @default("#3B82F6")
  ownerId   String      @db.Uuid
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  owner     UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("task_categories")
}
